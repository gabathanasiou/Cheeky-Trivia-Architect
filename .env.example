# Copy to .env.local and fill in. Never commit .env.local.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Local API server (Vite dev proxies /api here)
PORT=4101

# Set to 1 to return deterministic fixtures instead of calling DeepSeek.
DEEPSEEK_MOCK=0

# SQLite database for jobs/items (CLI + UI share it)
ARCHITECT_DB=./data/architect.db
