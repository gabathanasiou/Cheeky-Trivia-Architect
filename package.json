{
  "name": "cheeky-trivia-architect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,magenta \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:ui": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production PORT=4100 tsx src/server/index.ts",
    "start:test": "rm -f data/test-architect.db* && NODE_ENV=test PORT=4102 DEEPSEEK_MOCK=1 ARCHITECT_DB=./data/test-architect.db tsx src/server/index.ts",
    "cli": "tsx src/cli/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:smart": "node scripts/smart-test.mjs",
    "test:baseline": "node scripts/test-baseline.mjs",
    "lint:tests": "node scripts/check-test-hygiene.mjs",
    "lint:types": "tsc --noEmit",
    "roadmap": "node scripts/roadmap.mjs",
    "roadmap:check": "node scripts/roadmap.mjs check",
    "lint:docs": "node scripts/check-doc-budget.mjs",
    "lint": "npm run roadmap:check && npm run lint:docs && npm run lint:tests && npm run lint:types",
    "merge:game": "tsx scripts/merge-to-bamboozle.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^0.563.0",
    "p-limit": "^7.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
